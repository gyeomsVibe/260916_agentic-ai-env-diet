{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coord:command:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "task_id", "card_revision", "acceptance_hash", "idempotency_key", "operation", "payload_ref"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "command_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "card_revision": {"type": "integer", "minimum": 0},
    "acceptance_hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "[0-9a-fA-F]{64}"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "enum": ["PROBE", "DISPATCH", "VERIFY", "RECONCILE", "PROMOTE_CANDIDATE"]},
    "payload_ref": {"type": "string", "minLength": 1},
    "parent_attempt_id": {"type": "string"}
  }
}
