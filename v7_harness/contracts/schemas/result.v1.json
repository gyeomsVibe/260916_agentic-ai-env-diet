{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultV1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "fencing_token",
    "status",
    "summary",
    "risks",
    "checks",
    "changed_files",
    "artifacts",
    "effects",
    "usage",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED_SAFE",
        "NEEDS_RECONCILIATION",
        "SUSPECT",
        "REJECTED",
        "OUTPUT_BUDGET_EXCEEDED"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2048
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "message": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 200
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "relative_path", "size", "sha256", "media_type"],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "media_type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effect_id", "kind", "idempotency_key", "state"],
        "properties": {
          "effect_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "provider_ref": {
            "type": ["string", "null"]
          },
          "state": {
            "type": "string",
            "enum": ["PENDING", "COMMITTED", "ROLLED_BACK", "UNKNOWN"]
          }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": ["turns", "input_tokens", "output_tokens", "elapsed_ms"],
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "thinking_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "receipt_ref": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
